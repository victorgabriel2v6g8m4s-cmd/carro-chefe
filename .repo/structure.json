{
  "schemaVersion": 1,
  "mapFile": "docs/governanca/MAPA_REPOSITORIO.md",
  "allowedRootDirectories": [
    ".agent-policy",
    ".codex",
    ".github",
    ".repo",
    "anexos",
    "apps",
    "cardápio",
    "deploy",
    "docs",
    "elementos gráficos",
    "logos",
    "mídias",
    "packages",
    "planejamento",
    "site",
    "tools"
  ],
  "allowedRootFiles": [
    ".env.example",
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    "NOTICE.md",
    "README.md",
    "REGRAS.md",
    "package-lock.json",
    "package.json",
    "prisma.config.ts",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "forbiddenRootEntries": [
    "output",
    "planta da estrutura"
  ],
  "managedDirectories": {
    "anexos": {
      "directories": [
        "financeiro"
      ],
      "files": []
    },
    "apps": {
      "directories": [
        "api",
        "gestao",
        "lily_acai",
        "qr_manipulator",
        "site"
      ],
      "files": [
        "AGENTS.md"
      ]
    },
    "deploy": {
      "directories": [
        "nginx",
        "scripts",
        "systemd",
        "validation"
      ],
      "files": [
        "README.md"
      ]
    },
    "docs": {
      "directories": [
        "carro-chefe",
        "cooklily",
        "execution-checkpoints",
        "ferramentas",
        "financeiro",
        "fundacao",
        "governanca",
        "historico",
        "lily-acai",
        "negocio",
        "operacao",
        "pre-lancamento",
        "referencias",
        "tecnologia"
      ],
      "files": [
        "AGENTS.md",
        "README.md"
      ]
    },
    "mídias": {
      "directories": [
        "cooklily",
        "espaco",
        "files",
        "originais",
        "produtos"
      ],
      "files": [
        "AGENTS.md",
        "README.md"
      ]
    },
    "packages": {
      "directories": [
        "contracts",
        "database",
        "lily-database",
        "ui"
      ],
      "files": [
        "AGENTS.md"
      ]
    },
    "tools": {
      "directories": [
        "agent-policy",
        "excel_recipe",
        "excel_snapshot",
        "lily-build-budget",
        "repo-map",
        "tool-health",
        "windows-supervisor"
      ],
      "files": [
        "AGENTS.md",
        "agent-runtime.mjs"
      ]
    }
  },
  "categories": [
    {
      "path": "apps/",
      "category": "Aplicações",
      "purpose": "Aplicações executáveis: API, Central, site público, QR Lab e frontend CookLily."
    },
    {
      "path": "packages/",
      "category": "Pacotes",
      "purpose": "Contratos, bancos e UI compartilhados; CookLily usa persistência isolada em lily-database."
    },
    {
      "path": "tools/",
      "category": "Ferramentas",
      "purpose": "Automação, políticas, Excel, budget CookLily, supervisor, health checks e mapa."
    },
    {
      "path": "deploy/",
      "category": "Infraestrutura",
      "purpose": "Nginx, systemd, scripts e validações de deploy."
    },
    {
      "path": "docs/",
      "category": "Documentação",
      "purpose": "Decisões, arquitetura, operação, CookLily, governança, histórico e referências."
    },
    {
      "path": "mídias/",
      "category": "Mídias",
      "purpose": "Acervo bruto, produtos, CookLily e registros visuais do espaço."
    },
    {
      "path": "logos/",
      "category": "Marca",
      "purpose": "Logotipos oficiais e elementos gráficos de marca."
    },
    {
      "path": "cardápio/",
      "category": "Cardápio visual",
      "purpose": "Originais do cardápio preservados sob regras próprias."
    },
    {
      "path": "anexos/",
      "category": "Anexos de dados",
      "purpose": "Arquivos binários e receitas de referência operacional/financeira."
    },
    {
      "path": "planejamento/",
      "category": "Legado operacional",
      "purpose": "Implementação legada preservada até paridade da arquitetura V2."
    },
    {
      "path": "site/",
      "category": "Legado de site",
      "purpose": "Placeholder histórico; novas implementações pertencem a apps/site/."
    },
    {
      "path": ".agent-policy/",
      "category": "Governança de agentes",
      "purpose": "Manifesto e cápsulas de política."
    },
    {
      "path": ".codex/",
      "category": "Configuração de agentes",
      "purpose": "Perfis e configuração Codex."
    },
    {
      "path": ".github/",
      "category": "Governança GitHub",
      "purpose": "CI, templates e automações do repositório."
    }
  ],
  "branchPolicy": {
    "canonical": [
      "main",
      "cooklily/canonical"
    ],
    "archive": "history/evidence",
    "temporaryPrefixes": [
      "feature/",
      "feat/",
      "fix/",
      "chore/",
      "docs/",
      "gate/",
      "dependabot/"
    ],
    "rules": [
      "Branches temporárias existem apenas enquanto houver trabalho/PR ativo.",
      "Branches concluídas ou substituídas devem ter a evidência preservada em history/evidence antes de serem removidas.",
      "Gate branches nunca substituem uma branch canônica.",
      "Não criar nova branch histórica por assunto; usar history/evidence."
    ]
  },
  "legacyNotes": [
    {
      "path": "planejamento/",
      "reason": "Preservado até paridade e migração definitiva da V2."
    },
    {
      "path": "site/",
      "reason": "Placeholder histórico; código público ativo fica em apps/site/."
    },
    {
      "path": "cardápio/",
      "reason": "Mantido por regras locais e preservação do original; novos derivados devem ser catalogados em mídias/."
    },
    {
      "path": "elementos gráficos/",
      "reason": "Originais de marca preservados; não criar novos arquivos soltos aqui."
    },
    {
      "path": "mídias/files/",
      "reason": "Acervo bruto legado preservado porque manifests e referências históricas apontam para esses caminhos; não receber novos arquivos."
    },
    {
      "path": "docs/lily-acai/",
      "reason": "Caminho físico histórico da documentação CookLily preservado por compatibilidade; docs/cooklily/ é o índice canônico."
    }
  ]
}
