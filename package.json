{
  "name": "carro-chefe-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Site público e Central Operacional do Carro Chefe.",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:gestao": "vite --config apps/gestao/vite.config.ts",
    "dev:site": "vite --config apps/site/vite.config.ts",
    "dev:qr": "vite --config apps/qr_manipulator/vite.config.ts",
    "build": "npm run db:generate && npm run build:gestao && npm run build:site && npm run build:qr && tsc -p apps/api/tsconfig.json",
    "build:gestao": "vite build --config apps/gestao/vite.config.ts",
    "build:site": "vite build --config apps/site/vite.config.ts",
    "build:qr": "vite build --config apps/qr_manipulator/vite.config.ts",
    "check": "npm run db:generate && npm run db:validate && tsc --noEmit -p tsconfig.json",
    "test": "npm run test:legacy && vitest run --config vitest.config.ts",
    "test:legacy": "npm --prefix planejamento test",
    "test:watch": "vitest",
    "policy:build": "node tools/agent-policy/cli.mjs build",
    "policy:check": "node tools/agent-policy/cli.mjs check",
    "policy:preflight": "node tools/agent-policy/cli.mjs preflight",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "bridge:codex": "tsx apps/api/src/workers/codex-bridge.ts",
    "agent:runtime": "node tools/agent-runtime.mjs",
    "webhooks:dispatch": "tsx apps/api/src/workers/webhook-dispatcher.ts",
    "supervisor:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows-supervisor/build.ps1",
    "supervisor:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows-supervisor/install-startup.ps1 -StartNow",
    "supervisor:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows-supervisor/uninstall-startup.ps1"
  },
  "engines": {"node": ">=20"},
  "dependencies": {"@fastify/cors":"^11.3.0","@fastify/multipart":"^10.1.0","@fastify/rate-limit":"^11.2.0","@fastify/static":"^10.1.3","@openai/codex-sdk":"^0.147.0","@prisma/adapter-better-sqlite3":"^7.9.1","@prisma/client":"^7.9.1","better-sqlite3":"^12.11.1","fastify":"^5.11.3","playwright-core":"^1.62.1","react":"^19.2.8","react-dom":"^19.2.8","react-router-dom":"^7.18.2","zod":"^4.4.3"},
  "devDependencies": {"@types/better-sqlite3":"^9.6.0","@types/node":"^26.2.0","@types/react":"^19.2.18","@types/react-dom":"^19.2.4","@vitejs/plugin-react":"^6.0.5","prisma":"^7.9.1","tsx":"^4.23.12","typescript":"^7.0.2","vite":"^8.2.1","vitest":"^4.1.10"}
}
