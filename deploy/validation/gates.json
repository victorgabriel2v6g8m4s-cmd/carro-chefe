{
  "schemaVersion": 1,
  "gates": {
    "node-dependencies": {
      "description": "Dependências Node instaladas na VPS",
      "inputs": ["package.json", "package-lock.json"]
    },
    "preflight-migrations": {
      "description": "Aplicação das migrations em bancos temporários isolados",
      "inputs": [
        "prisma.config.ts",
        "packages/database/prisma",
        "packages/lily-database/prisma.config.ts",
        "packages/lily-database/prisma",
        "package.json",
        "package-lock.json"
      ],
      "requiredPaths": [
        ".runtime/deploy-preflight-core.db",
        ".runtime/deploy-preflight-lily.db"
      ]
    },
    "static-checks": {
      "description": "Prisma validate e TypeScript sem emissão",
      "inputs": [
        "tsconfig.json",
        "prisma.config.ts",
        "apps/api/tsconfig.json",
        "apps/api/src",
        "apps/site/src",
        "apps/lily_acai/src",
        "packages/database",
        "packages/lily-database",
        "package.json",
        "package-lock.json"
      ]
    },
    "tests": {
      "description": "Suítes automatizadas Node/Vitest do runtime",
      "inputs": [
        "vitest.config.ts",
        "tsconfig.json",
        "apps/api",
        "apps/site",
        "apps/lily_acai",
        "packages/database",
        "packages/lily-database",
        "deploy/scripts",
        "deploy/validation",
        "package.json",
        "package-lock.json"
      ]
    },
    "build": {
      "description": "Builds de produção e compilação da API",
      "inputs": [
        "tsconfig.json",
        "apps/api/tsconfig.json",
        "apps/api/src",
        "apps/site",
        "apps/lily_acai",
        "packages/database",
        "packages/lily-database",
        "package.json",
        "package-lock.json"
      ],
      "envInputs": ["VITE_GA4_ID", "VITE_CLARITY_ID"]
    }
  }
}
