#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  echo "Uso: sudo bash deploy/scripts/capture-cooklily-tcp-path [--minutes 5]"
  echo "Captura cabeçalhos TCP da porta 443 (sem payload), mascara IPs e grava TXT privado em /var/tmp."
}

MINUTES=5
while (($#)); do
  case "$1" in
    --minutes)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { usage >&2; exit 64; }
      MINUTES="$2"
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
  esac
done
(( MINUTES >= 1 && MINUTES <= 15 )) || { echo "--minutes deve ficar entre 1 e 15." >&2; exit 64; }
(( EUID == 0 )) || { echo "Execute com sudo/root." >&2; exit 77; }
command -v tcpdump >/dev/null && command -v timeout >/dev/null && command -v python3 >/dev/null || {
  echo "São necessários tcpdump, timeout e python3." >&2
  exit 69
}

umask 077
REPORT="$(mktemp "/var/tmp/cooklily-tcp-path-$(date +%Y%m%d-%H%M%S)-XXXXXX.txt")"
chmod 0600 "$REPORT"
SECONDS_TO_CAPTURE=$((MINUTES * 60))
{
  echo "CookLily TCP path capture"
  echo "Início: $(date --iso-8601=seconds 2>/dev/null || date)"
  echo "Duração: ${MINUTES} minutos"
  echo "Captura: somente metadados de cabeçalho TCP na porta 443; snaplen 96, sem impressão nem gravação do payload."
  echo "Privacidade: IPv4 mascarado em /24; IPv6 em /48; relatório modo 0600."
  echo "Relatório: ${REPORT}"
  echo
} | tee -a "$REPORT"

set +e
timeout --signal=INT --kill-after=5s "${SECONDS_TO_CAPTURE}s" \
  tcpdump -n -tttt -i any -s 96 'tcp port 443' 2>/dev/null |
  python3 -c "$(cat <<'PY'
from datetime import datetime, timezone
import ipaddress
import re
import sys

report = sys.argv[1]
ipv4 = re.compile(r"(?<![\w.])(?:\d{1,3}\.){3}\d{1,3}(?![\w])")
ipv6 = re.compile(r"(?<![0-9A-Fa-f:])(?:[0-9A-Fa-f]{0,4}:){2,}[0-9A-Fa-f]{0,4}(?![0-9A-Fa-f:])")

def mask(match):
    value = match.group(0)
    if value == "::" or not re.search(r"[0-9A-Fa-f]", value):
        return value
    try:
        address = ipaddress.ip_address(value)
        prefix = 24 if address.version == 4 else 48
        return f"{ipaddress.ip_network(f'{address}/{prefix}', strict=False).network_address}/{prefix}"
    except ValueError:
        return value

count = 0
with open(report, "a", encoding="utf-8") as output:
    for line in sys.stdin:
        line = ipv4.sub(mask, line)
        line = ipv6.sub(mask, line)
        output.write(f"[{datetime.now(timezone.utc).isoformat(timespec='seconds')}] {line.rstrip()}\n")
        output.flush()
        count += 1
    output.write(f"\nPacotes TCP observados: {count}\n")
    output.flush()
print(f"Captura TCP concluída. Pacotes: {count}. Relatório: {report}")
PY
)" "$REPORT"
PIPE_STATUS=("${PIPESTATUS[@]}")
set -e
TCPDUMP_STATUS="${PIPE_STATUS[0]:-1}"
(( TCPDUMP_STATUS == 0 || TCPDUMP_STATUS == 124 )) || {
  echo "tcpdump/timeout falhou (status ${TCPDUMP_STATUS}); relatório parcial: ${REPORT}" >&2
  exit "$TCPDUMP_STATUS"
}
