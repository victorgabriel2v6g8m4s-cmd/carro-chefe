#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${CARRO_CHEFE_APP_DIR:-/srv/carro-chefe/current}"
DATA_DIR="${CARRO_CHEFE_DATA_DIR:-/srv/carro-chefe/data}"
ENV_FILE="${CARRO_CHEFE_ENV_FILE:-/etc/carro-chefe/carro-chefe.env}"
NGINX_CONF="${CARRO_CHEFE_NGINX_CONF:-/etc/nginx/sites-available/carrochefe.com}"
SERVICE="${CARRO_CHEFE_SERVICE:-carro-chefe}"
SERVICE_USER="${CARRO_CHEFE_SERVICE_USER:-carrochefe}"
SERVICE_GROUP="${CARRO_CHEFE_SERVICE_GROUP:-carrochefe}"
BACKUP_DIR="${CARRO_CHEFE_BACKUP_DIR:-${DATA_DIR}/backups}"
LOG_DIR="${CARRO_CHEFE_DEPLOY_LOG_DIR:-${DATA_DIR}/deploy-logs}"
LOCK_FILE="${CARRO_CHEFE_DEPLOY_LOCK:-/run/lock/carro-chefe-deploy.lock}"
VALIDATION_CACHE_DIR="${CARRO_CHEFE_VALIDATION_CACHE_DIR:-${DATA_DIR}/deploy-validation}"
READINESS_ATTEMPTS="${CARRO_CHEFE_READINESS_ATTEMPTS:-30}"
READINESS_DELAY_SECONDS="${CARRO_CHEFE_READINESS_DELAY_SECONDS:-1}"
ORIGINAL_ARGS=("$@")

usage() {
  cat <<'EOF'
Uso:
  sudo carro-chefe-deploy <release-sha> [--full-validation]

Executa deploy fail-closed por SHA imutável. Gates repetíveis usam cache por
fingerprint de inputs; backup, migrations reais, Nginx, restart e health/smoke
sempre executam. Use --full-validation para ignorar o cache nesta execução.

O script NÃO:
  - executa prisma reset/seed;
  - executa npm audit fix;
  - sobrescreve a configuração real do Nginx;
  - faz rollback automático de banco após migration iniciada.
EOF
}

early_die() {
  echo "ERRO: $*" >&2
  exit 1
}

[[ "${READINESS_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || early_die "CARRO_CHEFE_READINESS_ATTEMPTS deve ser inteiro positivo"
[[ "${READINESS_DELAY_SECONDS}" =~ ^[1-9][0-9]*$ ]] || early_die "CARRO_CHEFE_READINESS_DELAY_SECONDS deve ser inteiro positivo"
[[ ${EUID} -eq 0 ]] || early_die "execute como root/sudo"

RELEASE_SHA=""
FULL_VALIDATION=0
for arg in "$@"; do
  case "${arg}" in
    --full-validation) FULL_VALIDATION=1 ;;
    -h|--help) usage; exit 0 ;;
    *)
      if [[ -z "${RELEASE_SHA}" && "${arg}" =~ ^[0-9a-fA-F]{40}$ ]]; then
        RELEASE_SHA="${arg,,}"
      else
        usage
        early_die "argumento inválido: ${arg}"
      fi
      ;;
  esac
done
[[ -n "${RELEASE_SHA}" ]] || { usage; exit 64; }

for command in git npm node sqlite3 systemctl nginx curl python3 flock tee sha256sum readlink; do
  command -v "${command}" >/dev/null 2>&1 || early_die "comando obrigatório ausente: ${command}"
done

[[ -d "${APP_DIR}/.git" ]] || early_die "${APP_DIR} não é o checkout Git esperado"
[[ -f "${ENV_FILE}" ]] || early_die "arquivo de ambiente ausente: ${ENV_FILE}"
[[ -f "${NGINX_CONF}" ]] || early_die "configuração Nginx ausente: ${NGINX_CONF}"

DEPLOYER_PATH="$(readlink -f "${BASH_SOURCE[0]}")"

mkdir -p "${BACKUP_DIR}" "${LOG_DIR}" "${VALIDATION_CACHE_DIR}"
chmod 700 "${VALIDATION_CACHE_DIR}" || true
if [[ "${CARRO_CHEFE_DEPLOY_REEXEC:-0}" != "1" ]]; then
  exec 9>"${LOCK_FILE}"
  flock -n 9 || early_die "outro deploy já está em execução"
else
  [[ -e "/proc/self/fd/9" ]] || early_die "reexec do deployer sem lock herdado"
fi

STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_FILE="${LOG_DIR}/deploy-${STAMP}-${RELEASE_SHA:0:12}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

cd "${APP_DIR}"
PREVIOUS_SHA="$(git rev-parse HEAD)"
PHASE="init"
SERVICE_STOPPED=0
MIGRATION_STARTED=0

cleanup_on_error() {
  local status="${1:-$?}"
  echo
  echo "DEPLOY FALHOU | fase=${PHASE} | status=${status}"
  echo "release=${RELEASE_SHA}"
  echo "previous=${PREVIOUS_SHA}"
  echo "log=${LOG_FILE}"

  if [[ "${MIGRATION_STARTED}" -eq 0 ]]; then
    echo "Nenhuma migration real foi iniciada; restaurando checkout anterior."
    git checkout --detach "${PREVIOUS_SHA}" || true
    if [[ -d node_modules ]] && git diff --quiet "${PREVIOUS_SHA}" "${RELEASE_SHA}" -- package.json package-lock.json; then
      echo "rollback_dependencies=reused"
    else
      npm ci --include=dev || true
    fi
    if [[ "${SERVICE_STOPPED}" -eq 1 ]]; then
      systemctl start "${SERVICE}" || true
    fi
  else
    echo "Migration real já foi iniciada. Rollback de banco NÃO será automatizado."
    echo "Consulte os backups em ${BACKUP_DIR} e o runbook antes de qualquer restauração."
  fi
  exit "${status}"
}
trap cleanup_on_error ERR

fail() {
  echo "ERRO: $*" >&2
  cleanup_on_error 1
}

echo "== Carro Chefe deploy =="
echo "timestamp=${STAMP}"
echo "previous_sha=${PREVIOUS_SHA}"
echo "release_sha=${RELEASE_SHA}"
echo "validation_mode=$([[ "${FULL_VALIDATION}" -eq 1 ]] && echo full || echo incremental)"
echo "validation_cache_dir=${VALIDATION_CACHE_DIR}"
echo "log=${LOG_FILE}"

PHASE="validate-worktree"
if [[ -n "$(git status --porcelain)" ]]; then
  git status --short
  fail "checkout possui alterações; deploy cancelado"
fi

PHASE="fetch"
git fetch origin --prune
git cat-file -e "${RELEASE_SHA}^{commit}" || fail "SHA não existe no repositório local após fetch"
git show --no-patch --format='release_commit=%H %s' "${RELEASE_SHA}"

if [[ "${CARRO_CHEFE_DEPLOY_REEXEC:-0}" != "1" ]]; then
  TARGET_DEPLOYER_TMP="/tmp/carro-chefe-deploy-${RELEASE_SHA}"
  git show "${RELEASE_SHA}:deploy/scripts/carro-chefe-deploy" > "${TARGET_DEPLOYER_TMP}" \
    || fail "release não contém deploy/scripts/carro-chefe-deploy"
  chmod 0700 "${TARGET_DEPLOYER_TMP}"
  bash -n "${TARGET_DEPLOYER_TMP}" || fail "deployer do release possui sintaxe Bash inválida"

  CURRENT_DEPLOYER_SHA="$(sha256sum "${DEPLOYER_PATH}" | awk '{print $1}')"
  TARGET_DEPLOYER_SHA="$(sha256sum "${TARGET_DEPLOYER_TMP}" | awk '{print $1}')"
  if [[ "${CURRENT_DEPLOYER_SHA}" != "${TARGET_DEPLOYER_SHA}" ]]; then
    echo "deployer_update=reexec target=${RELEASE_SHA} current_sha256=${CURRENT_DEPLOYER_SHA} target_sha256=${TARGET_DEPLOYER_SHA}"
    exec env CARRO_CHEFE_DEPLOY_REEXEC=1 "${TARGET_DEPLOYER_TMP}" "${ORIGINAL_ARGS[@]}"
  fi
  rm -f "${TARGET_DEPLOYER_TMP}"
else
  echo "deployer_update=reexec_ok release=${RELEASE_SHA}"
fi

PHASE="nginx-precheck"
required_nginx_patterns=(
  'location ^~ /api/v1/lily/public/'
  'location ^~ /api/v1/lily/auth/'
  'location ^~ /api/v1/lily/admin/'
  'location = /api/v1/lily/orders'
  'location ^~ /api/v1/lily/orders/'
  'location = /api/v1/lily/payments'
  'location ^~ /api/v1/lily/payments/'
  'location ^~ /api/v1/lily/customer/'
  'location ^~ /api/v1/lily/courier/'
  'location ^~ /api/ { return 404; }'
)
for pattern in "${required_nginx_patterns[@]}"; do
  grep -Fq "${pattern}" "${NGINX_CONF}" || fail "Nginx ainda não contém rota obrigatória: ${pattern}"
done
nginx -t

PHASE="checkout"
git checkout --detach "${RELEASE_SHA}"
[[ "$(git rev-parse HEAD)" == "${RELEASE_SHA}" ]] || fail "checkout não ficou no SHA solicitado"
[[ -f deploy/scripts/deploy-validation.mjs ]] || fail "release não contém deploy/scripts/deploy-validation.mjs"
[[ -f deploy/validation/gates.json ]] || fail "release não contém deploy/validation/gates.json"

PHASE="environment"
set -a
# shellcheck disable=SC1090
. "${ENV_FILE}"
set +a

[[ -n "${DATABASE_URL:-}" ]] || fail "DATABASE_URL ausente"
[[ -n "${LILY_DATABASE_URL:-}" ]] || fail "LILY_DATABASE_URL ausente"
[[ -n "${LILY_UPLOAD_DIR:-}" ]] || fail "LILY_UPLOAD_DIR ausente"
[[ -n "${LILY_MFA_ENCRYPTION_KEY:-}" ]] || fail "LILY_MFA_ENCRYPTION_KEY ausente"
node -e 'const value=process.env.LILY_MFA_ENCRYPTION_KEY||""; const key=Buffer.from(value,"base64url"); if (key.length !== 32 || key.toString("base64url") !== value) process.exit(1);' \
  || fail "LILY_MFA_ENCRYPTION_KEY deve conter 32 bytes em base64url"

[[ -n "${COOKLILY_LOGISTICS_CODE_KEY:-}" ]] || fail "COOKLILY_LOGISTICS_CODE_KEY ausente"
node -e 'const value=process.env.COOKLILY_LOGISTICS_CODE_KEY||""; const key=Buffer.from(value,"base64url"); if (key.length !== 32 || key.toString("base64url") !== value) process.exit(1);' \
  || fail "COOKLILY_LOGISTICS_CODE_KEY deve conter 32 bytes em base64url"

[[ "${DATABASE_URL}" == file:/srv/carro-chefe/data/* ]] || fail "DATABASE_URL fora do volume esperado"
[[ "${LILY_DATABASE_URL}" == file:/srv/carro-chefe/data/* ]] || fail "LILY_DATABASE_URL fora do volume esperado"
[[ "${LILY_UPLOAD_DIR}" == /srv/carro-chefe/data/* ]] || fail "LILY_UPLOAD_DIR fora do volume esperado"

run_cached_gate() {
  local gate="$1"
  local local_force="$2"
  shift 2
  local args=(run "${gate}" --cache-dir "${VALIDATION_CACHE_DIR}")
  if [[ "${FULL_VALIDATION}" -eq 1 || "${local_force}" -eq 1 ]]; then
    args+=(--force)
  fi
  node deploy/scripts/deploy-validation.mjs "${args[@]}" -- "$@"
}

PHASE="dependencies"
NODE_DEPS_FORCE=0
[[ -f node_modules/.package-lock.json ]] || NODE_DEPS_FORCE=1
run_cached_gate node-dependencies "${NODE_DEPS_FORCE}" npm ci --include=dev

PHASE="python-tooling"
PYTHON_FORCE=0
if [[ ! -x .runtime/tool-health-venv/bin/python ]] || ! .runtime/tool-health-venv/bin/python -c 'import openpyxl, oletools' >/dev/null 2>&1; then
  PYTHON_FORCE=1
fi
run_cached_gate python-tooling "${PYTHON_FORCE}" bash -c 'mkdir -p .runtime && rm -rf .runtime/tool-health-venv && python3 -m venv .runtime/tool-health-venv && .runtime/tool-health-venv/bin/python -m pip install --disable-pip-version-check --requirement tools/excel_snapshot/requirements.txt'
export PATH="${APP_DIR}/.runtime/tool-health-venv/bin:${PATH}"
hash -r
python3 -c "import openpyxl, oletools; print('python_tooling=ok')"

PROD_DATABASE_URL="${DATABASE_URL}"
PROD_LILY_DATABASE_URL="${LILY_DATABASE_URL}"
PRE_CORE="${APP_DIR}/.runtime/deploy-preflight-core.db"
PRE_LILY="${APP_DIR}/.runtime/deploy-preflight-lily.db"
rm -f "${PRE_CORE}" "${PRE_CORE}-wal" "${PRE_CORE}-shm" \
      "${PRE_LILY}" "${PRE_LILY}-wal" "${PRE_LILY}-shm"
export DATABASE_URL="file:${PRE_CORE}"
export LILY_DATABASE_URL="file:${PRE_LILY}"

PHASE="preflight-migrations"
run_cached_gate preflight-migrations 0 npm run db:deploy

PHASE="policy"
run_cached_gate policy 0 npm run policy:check

PHASE="static-checks"
run_cached_gate static-checks 0 npm run check

PHASE="tests"
run_cached_gate tests 0 env NODE_ENV=test npm test

PHASE="build"
BUILD_FORCE=0
for artifact in apps/gestao/dist/index.html apps/site/dist/index.html apps/qr_manipulator/dist/index.html apps/lily_acai/dist/index.html dist/api; do
  [[ -e "${artifact}" ]] || BUILD_FORCE=1
done
run_cached_gate build "${BUILD_FORCE}" npm run build

PHASE="tool-health"
run_cached_gate tool-health 0 npm run tools:status:check

export DATABASE_URL="${PROD_DATABASE_URL}"
export LILY_DATABASE_URL="${PROD_LILY_DATABASE_URL}"

PHASE="post-gates-cleanliness"
find tools -type d -name '__pycache__' -prune -exec rm -rf {} +
find tools -type f -name '*.pyc' -delete

if [[ -n "$(git status --porcelain)" ]]; then
  git status --short
  fail "gates alteraram arquivos versionados/não ignorados"
fi

PHASE="backup"
CORE_DB="${DATABASE_URL#file:}"
LILY_DB="${LILY_DATABASE_URL#file:}"
mkdir -p "${LILY_UPLOAD_DIR}"

CORE_BACKUP="${BACKUP_DIR}/carro-chefe-pre-${RELEASE_SHA:0:12}-${STAMP}.db"
LILY_BACKUP=""
sqlite3 "${CORE_DB}" ".backup '${CORE_BACKUP}'"
echo "core_backup=${CORE_BACKUP}"

if [[ -f "${LILY_DB}" ]]; then
  LILY_BACKUP="${BACKUP_DIR}/lily-acai-pre-${RELEASE_SHA:0:12}-${STAMP}.db"
  sqlite3 "${LILY_DB}" ".backup '${LILY_BACKUP}'"
  echo "lily_backup=${LILY_BACKUP}"
else
  echo "lily_backup=not_applicable_database_missing"
fi

PHASE="backup-verify"
bash deploy/scripts/verify-sqlite-backup "${CORE_BACKUP}" core
CORE_BACKUP_SHA256="$(sha256sum "${CORE_BACKUP}" | awk '{print $1}')"
if [[ -n "${LILY_BACKUP}" ]]; then
  bash deploy/scripts/verify-sqlite-backup "${LILY_BACKUP}" lily
  LILY_BACKUP_SHA256="$(sha256sum "${LILY_BACKUP}" | awk '{print $1}')"
else
  LILY_BACKUP_SHA256="not_applicable"
fi

PHASE="stop-service"
systemctl stop "${SERVICE}"
SERVICE_STOPPED=1
[[ "$(systemctl is-active "${SERVICE}" || true)" == "inactive" ]] || fail "serviço não ficou inativo"

if command -v fuser >/dev/null 2>&1; then
  if fuser "${CORE_DB}" >/dev/null 2>&1; then
    fuser "${CORE_DB}" || true
    fail "core SQLite continua em uso após stop"
  fi
  if [[ -f "${LILY_DB}" ]] && fuser "${LILY_DB}" >/dev/null 2>&1; then
    fuser "${LILY_DB}" || true
    fail "Lily SQLite continua em uso após stop"
  fi
fi

PHASE="production-migrations"
MIGRATION_STARTED=1
npm run db:deploy:core
npm run db:deploy:lily

PHASE="permissions"
chown "${SERVICE_USER}:${SERVICE_GROUP}" "${CORE_DB}" || true
[[ -f "${LILY_DB}" ]] && chown "${SERVICE_USER}:${SERVICE_GROUP}" "${LILY_DB}"
for suffix in -wal -shm; do
  [[ -f "${CORE_DB}${suffix}" ]] && chown "${SERVICE_USER}:${SERVICE_GROUP}" "${CORE_DB}${suffix}"
  [[ -f "${LILY_DB}${suffix}" ]] && chown "${SERVICE_USER}:${SERVICE_GROUP}" "${LILY_DB}${suffix}"
done
mkdir -p "${LILY_UPLOAD_DIR}"
chown -R "${SERVICE_USER}:${SERVICE_GROUP}" "$(dirname "${LILY_UPLOAD_DIR}")"
chmod 750 "$(dirname "${LILY_UPLOAD_DIR}")" "${LILY_UPLOAD_DIR}"

PHASE="nginx"
nginx -t
systemctl reload nginx

PHASE="restart-service"
systemctl start "${SERVICE}"
SERVICE_STOPPED=0

wait_for_internal_health() {
  local attempt
  local health_tmp="/tmp/carro-chefe-health-${STAMP}"
  local health_error_tmp="/tmp/carro-chefe-health-error-${STAMP}"
  echo "Aguardando readiness do Fastify em 127.0.0.1:4173..."

  for ((attempt=1; attempt<=READINESS_ATTEMPTS; attempt++)); do
    if [[ "$(systemctl is-active "${SERVICE}" || true)" != "active" ]]; then
      echo "Tentativa ${attempt}/${READINESS_ATTEMPTS}: serviço ainda não está active."
    elif curl --fail --silent --show-error --max-time 2 \
      http://127.0.0.1:4173/api/health >"${health_tmp}" 2>"${health_error_tmp}"; then
      cat "${health_tmp}"
      echo
      rm -f "${health_tmp}" "${health_error_tmp}"
      echo "readiness=ok attempt=${attempt}"
      return 0
    else
      echo "Tentativa ${attempt}/${READINESS_ATTEMPTS}: aplicação ainda não respondeu ao health."
    fi

    sleep "${READINESS_DELAY_SECONDS}"
  done

  echo "Readiness não ficou saudável após ${READINESS_ATTEMPTS} tentativas."
  systemctl status "${SERVICE}" --no-pager -l || true
  journalctl -u "${SERVICE}" -n 120 --no-pager || true
  command -v ss >/dev/null 2>&1 && ss -ltnp | grep ':4173' || true
  [[ -f "${health_error_tmp}" ]] && cat "${health_error_tmp}" || true
  rm -f "${health_tmp}" "${health_error_tmp}"
  return 1
}

PHASE="readiness"
wait_for_internal_health || fail "Fastify não ficou pronto dentro da janela de readiness"

PHASE="health"
curl --fail --silent --show-error --max-time 5 http://127.0.0.1:4173/api/v1/lily/public/health
echo
curl --fail --silent --show-error --max-time 5 http://127.0.0.1:4173/api/v1/lily/public/fulfillment
echo

PHASE="external-smoke"
external_ok=0
for attempt in 1 2 3 4 5; do
  if curl --fail --silent --show-error --max-time 8 \
    https://carrochefe.com/api/v1/lily/public/health; then
    echo
    echo "external_smoke=ok attempt=${attempt}"
    external_ok=1
    break
  fi
  sleep 1
done
[[ "${external_ok}" -eq 1 ]] || fail "health HTTPS externo não respondeu após 5 tentativas"

PHASE="operator-tools"
if [[ -f "${APP_DIR}/deploy/scripts/lily-promote-user" ]]; then
  install -m 0755 "${APP_DIR}/deploy/scripts/lily-promote-user" /usr/local/sbin/lily-promote-user
  echo "operator_tool=/usr/local/sbin/lily-promote-user"
fi
if [[ -f "${APP_DIR}/deploy/scripts/verify-sqlite-backup" ]]; then
  install -m 0755 "${APP_DIR}/deploy/scripts/verify-sqlite-backup" /usr/local/sbin/carro-chefe-verify-backup
  echo "operator_tool=/usr/local/sbin/carro-chefe-verify-backup"
fi
if [[ -f "${APP_DIR}/deploy/scripts/cc" ]]; then
  install -m 0755 "${APP_DIR}/deploy/scripts/cc" /usr/local/sbin/cc
  echo "operator_tool=/usr/local/sbin/cc"
fi

PHASE="evidence"
EVIDENCE_FILE="${LOG_DIR}/deploy-${STAMP}-${RELEASE_SHA:0:12}.evidence"
cat > "${EVIDENCE_FILE}" <<EOF
timestamp=${STAMP}
previous_sha=${PREVIOUS_SHA}
release_sha=${RELEASE_SHA}
validation_mode=$([[ "${FULL_VALIDATION}" -eq 1 ]] && echo full || echo incremental)
validation_cache_dir=${VALIDATION_CACHE_DIR}
core_backup=${CORE_BACKUP}
core_backup_sha256=${CORE_BACKUP_SHA256}
lily_backup=${LILY_BACKUP:-not_applicable}
lily_backup_sha256=${LILY_BACKUP_SHA256}
backup_verification=ok
nginx_config=${NGINX_CONF}
service=${SERVICE}
service_status=$(systemctl is-active "${SERVICE}")
internal_health=ok
lily_health=ok
fulfillment_health=ok
external_health=ok
log=${LOG_FILE}
EOF

trap - ERR
echo
echo "DEPLOY CONCLUÍDO"
echo "release_sha=${RELEASE_SHA}"
echo "previous_sha=${PREVIOUS_SHA}"
echo "validation_mode=$([[ "${FULL_VALIDATION}" -eq 1 ]] && echo full || echo incremental)"
echo "evidence=${EVIDENCE_FILE}"
echo "log=${LOG_FILE}"
echo
echo "Próximos deploys podem usar: sudo cc deploy canonical"
echo "Validação completa forçada: sudo cc deploy canonical --full"
echo
echo "Rollback de aplicação, se compatível com o schema:"
echo "  cd ${APP_DIR} && git checkout --detach ${PREVIOUS_SHA} && npm ci --include=dev && systemctl restart ${SERVICE}"
echo "Restauração de banco exige decisão manual com os backups acima."
