#!/usr/bin/env bash
set -Eeuo pipefail

CONF="${CARRO_CHEFE_NGINX_CONF:-/etc/nginx/sites-available/carrochefe.com}"
BACKUP_DIR="${CARRO_CHEFE_BACKUP_DIR:-/srv/carro-chefe/data/backups}"

[[ ${EUID} -eq 0 ]] || { echo "Execute como root/sudo." >&2; exit 1; }
[[ -f "${CONF}" ]] || { echo "Configuração não encontrada: ${CONF}" >&2; exit 1; }

mkdir -p "${BACKUP_DIR}"
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="${BACKUP_DIR}/nginx-pre-survey-routes-${STAMP}.conf"
cp -a "${CONF}" "${BACKUP}"

python3 - "${CONF}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
marker = "    location ^~ /api/ { return 404; }"

def proxy_route(location):
    return f'''    {location} {{
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }}'''

groups = [
    (
        "pesquisa",
        "    # CookLily: lista, início, progresso, envio de respostas e anexos de pesquisa. Sessão e CSRF são validados no Fastify.\n" +
        proxy_route("location = /api/v1/lily/surveys") + "\n\n" +
        proxy_route("location ^~ /api/v1/lily/surveys/"),
        ("location = /api/v1/lily/surveys", "location ^~ /api/v1/lily/surveys/"),
    ),
    (
        "notificação",
        "    # CookLily: notificações e marcação de leitura; sessão e CSRF são validados no Fastify.\n" +
        proxy_route("location = /api/v1/lily/notifications") + "\n\n" +
        proxy_route("location ^~ /api/v1/lily/notifications/"),
        ("location = /api/v1/lily/notifications", "location ^~ /api/v1/lily/notifications/"),
    ),
]

missing_blocks = []
for name, block, routes in groups:
    present = tuple(route in text for route in routes)
    if any(present) and not all(present):
        print(f"Configuração parcial das rotas de {name} detectada; abortando sem alteração.", file=sys.stderr)
        raise SystemExit(2)
    if not all(present):
        missing_blocks.append(block)

if not missing_blocks:
    print("Rotas Lily de pesquisas e notificações já estão presentes; nenhuma alteração necessária.")
    raise SystemExit(0)
if marker not in text:
    print("Bloqueio genérico /api/ não encontrado no formato esperado; abortando.", file=sys.stderr)
    raise SystemExit(3)

text = text.replace(marker, "\n\n".join(missing_blocks) + "\n\n" + marker, 1)
path.write_text(text, encoding="utf-8")
print("Rotas ausentes de pesquisas/notificações CookLily inseridas antes do bloqueio genérico de API.")
PY

if ! nginx -t; then
  echo "nginx -t falhou; restaurando backup: ${BACKUP}" >&2
  cp -a "${BACKUP}" "${CONF}"
  nginx -t || true
  exit 1
fi

systemctl reload nginx
echo "Nginx preparado para pesquisas e notificações CookLily."
echo "backup=${BACKUP}"
