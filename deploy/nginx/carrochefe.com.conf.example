# P0 de pré-lançamento: somente o site e a API pública de cadastro/analytics
# ficam expostos. /gestao e demais /api continuam bloqueados até autenticação.

server {
    listen 80;
    listen [::]:80;
    server_name carrochefe.com www.carrochefe.com;
    return 301 https://carrochefe.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name carrochefe.com;

    # Caminhos esperados quando o certificado for emitido pelo Certbot.
    ssl_certificate /etc/letsencrypt/live/carrochefe.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/carrochefe.com/privkey.pem;

    client_max_body_size 12m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Único namespace de API aberto ao público no P0.
    location ^~ /api/v1/public/prelaunch/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # CookLily: catálogo/health/config/leads/mídia públicos.
    location ^~ /api/v1/lily/public/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # CookLily: autenticação própria necessária para conta e painel.
    location ^~ /api/v1/lily/auth/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # CookLily: rotas staff protegidas no Fastify por sessão, papel, CSRF,
    # rate limit e auditoria. Upload respeita client_max_body_size.
    location ^~ /api/v1/lily/admin/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # CookLily: criação do pedido usa a rota exata sem barra final.
    location = /api/v1/lily/orders {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # CookLily: cotação e subrotas de pedidos.
    location ^~ /api/v1/lily/orders/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # CookLily: criação/consulta de pagamentos. Autorização real permanece no Fastify.
    location = /api/v1/lily/payments {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location ^~ /api/v1/lily/payments/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # CookLily: recursos do titular autenticado, como endereços e histórico.
    location ^~ /api/v1/lily/customer/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Não publicar a Central nem as APIs operacionais antes de autenticação,
    # autorização e CSRF estarem efetivamente implementados e homologados.
    location ^~ /api/ { return 404; }
    location = /gestao { return 404; }
    location ^~ /gestao/ { return 404; }

    # Site público e ativos. O Fastify serve o build Vite do mesmo processo.
    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.carrochefe.com;
    ssl_certificate /etc/letsencrypt/live/carrochefe.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/carrochefe.com/privkey.pem;
    return 301 https://carrochefe.com$request_uri;
}
