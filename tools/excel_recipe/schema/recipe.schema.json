{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carrochefe.com/schemas/excel-recipe-v3a-g1.json",
  "title": "Excel Recipe Engine V3A / Generic G1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "workbook", "operations"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,100}$" },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "\\.[xX][lL][sS][mM]$" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_vba_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "output": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "receipt_path": { "type": "string", "pattern": "\\.json$" },
    "operations": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "operation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "cell.set", "cell.clear", "formula.set", "formula.copy",
            "dependency.scan", "dependency.assert_clean",
            "structural.plan", "structural.assert_clean",
            "sheet.insert_rows", "sheet.delete_rows", "sheet.insert_columns", "sheet.delete_columns",
            "range.move", "table.insert_column", "table.delete_column", "table.compact_rows",
            "table.rename", "table.rename_column",
            "table.append_rows", "table.upsert_rows", "table.update_rows", "table.delete_rows",
            "table.create", "table.resize", "table.drop", "table.add_column", "table.set_formula_column",
            "assert.cell", "assert.table", "assert.row", "workbook.recalculate_on_open"
          ]
        },
        "action": {
          "enum": [
            "sheet.insert_rows", "sheet.delete_rows", "sheet.insert_columns", "sheet.delete_columns",
            "range.move", "table.insert_column", "table.delete_column", "table.compact_rows"
          ]
        },
        "sheet": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "new_name": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 },
        "at": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "position": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  }
}
