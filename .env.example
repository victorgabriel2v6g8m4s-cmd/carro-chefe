# Execução local; não publique segredos reais.
DATABASE_URL=file:./.runtime/carro-chefe.db
LILY_DATABASE_URL=file:./.runtime/lily-acai.db
# Produção: gere 32 bytes aleatórios e armazene em base64url. Nunca use o valor de exemplo.
# Ex.: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
LILY_MFA_ENCRYPTION_KEY=
# Chave independente para derivar códigos de coleta/entrega. Produção: 32 bytes aleatórios em base64url.
# Mantenha estável depois de começar a operar entregas; trocar a chave muda códigos de pedidos em andamento.
COOKLILY_LOGISTICS_CODE_KEY=
# Pix próprio CookLily. Deixe vazio localmente se não estiver homologando o provider próprio.
COOKLILY_PIX_KEY=
COOKLILY_PIX_MERCHANT_NAME=
COOKLILY_PIX_MERCHANT_CITY=CAMPO GRANDE
HOST=127.0.0.1
PORT=4173
DEFAULT_USER_ID=owner

# Origem pública oficial + origens locais de desenvolvimento. Restrinja este valor
# às origens realmente controladas quando configurar o ambiente da VPS.
CORS_ALLOWED_ORIGINS=https://carrochefe.com,http://127.0.0.1:4173,http://127.0.0.1:4174,http://localhost:4173,http://localhost:4174,http://127.0.0.1:5175,http://localhost:5175

# false localmente. Na VPS, use true somente quando o Fastify estiver atrás do
# reverse proxy controlado (ex.: Nginx) para rate limit e IP do cliente.
TRUST_PROXY=false

# IDs públicos de analytics. Deixe vazio para não carregar o fornecedor.
# Mesmo configurados, o frontend só injeta essas tags após opt-in explícito.
VITE_GA4_ID=
VITE_CLARITY_ID=

# Assinatura HMAC de webhooks recebidos.
WEBHOOK_SECRET=troque-por-um-segredo-longo
OUTBOUND_WEBHOOK_TIMEOUT_MS=10000

# Reservado para autenticação máquina-a-máquina dos agentes.
AGENT_API_KEY=troque-por-um-segredo-longo
MAX_AGENT_CONCURRENCY=3

# Continue false. Só altere após autenticação, sessão, RBAC e proteção CSRF.
# A estratégia P0 de VPS mantém /gestao e APIs internas bloqueadas no Nginx.
PRODUCTION_AUTH_READY=false

# O processo Node continua ligado apenas ao loopback. Não use HOST=0.0.0.0/::;
# a publicação externa deve acontecer exclusivamente pelo reverse proxy controlado.
