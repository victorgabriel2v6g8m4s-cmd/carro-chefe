# Execução local; não publique segredos reais.
DATABASE_URL=file:./.runtime/carro-chefe.db
HOST=127.0.0.1
PORT=4173
DEFAULT_USER_ID=owner

# false localmente. Na VPS, use true somente quando o Fastify estiver atrás do
# reverse proxy controlado (ex.: Nginx) para rate limit e IP do cliente.
TRUST_PROXY=false

# IDs públicos de analytics. Deixe vazio para não carregar o fornecedor.
# Mesmo configurados, o frontend só injeta essas tags após opt-in explícito.
VITE_GA4_ID=
VITE_CLARITY_ID=

# Assinatura HMAC de webhooks recebidos.
WEBHOOK_SECRET=troque-por-um-segredo-longo

# Reservado para autenticação máquina-a-máquina dos agentes.
AGENT_API_KEY=troque-por-um-segredo-longo
MAX_AGENT_CONCURRENCY=3

# Continue false. Só altere após autenticação, sessão, RBAC e proteção CSRF.
# A estratégia P0 de VPS mantém /gestao e APIs internas bloqueadas no Nginx.
PRODUCTION_AUTH_READY=false
