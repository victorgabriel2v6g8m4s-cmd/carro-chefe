generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
}

model LilyUser {
  id              String              @id @default(cuid())
  phoneNormalized String              @unique
  passwordHash    String
  displayName     String?
  role            String              @default("customer")
  status          String              @default("active")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        LilySession[]
  consents        LilyConsentRecord[]
  addresses       LilyAddress[]
  orders          LilyOrder[]
  loyaltyEvents   LilyLoyaltyEvent[]
  lilyCoinEvents  LilyCoinEvent[]
  rewardRedemptions LilyRewardRedemption[]
  surveyParticipations LilySurveyParticipation[]
  surveyResponses LilySurveyResponse[]
  surveyUploads   LilySurveyUpload[]
  notifications   LilyCustomerNotification[]
  vipMembership  LilyVipMembership?
  vipRedemptions LilyVipRedemption[]
  assignedCoupons LilyCoupon[] @relation("LilyAssignedCoupon")
  vipAnalytics LilyVipAnalyticsEvent[]
  referralInvites LilyReferralInvite[] @relation("LilyReferralOwner")
  referredBy LilyReferralInvite? @relation("LilyReferralRecipient")
  reelLikes       LilyReelLike[]
  reelSaves       LilyReelSave[]
  reelComments    LilyReelComment[]

  avatarMediaId   String?
  rankingOptIn    Boolean             @default(false)
  isTestAccount   Boolean             @default(false)
  staffPasswordUpgradeRequired Boolean @default(false)
  mfaEnabled                  Boolean  @default(false)
  mfaSecretEncrypted          String?
  mfaRecoveryCodesJson        String   @default("[]")
  mfaEnrolledAt               DateTime?
  agentIdentity               Boolean  @default(false)
  agentKey                    LilyAgentKey?

  @@index([status, createdAt])
}

model LilyOrderOperationEvent {
  id         String    @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actor      String
  note       String?
  createdAt  DateTime  @default(now())
  order      LilyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

model LilyOrderDeliveryEvent {
  id         String    @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actor      String
  note       String?
  createdAt  DateTime  @default(now())
  order      LilyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

model LilyWhatsAppMessageTemplate {
  id              String   @id @default(cuid())
  key             String   @unique
  displayName     String
  category        String   @default("utility")
  language        String   @default("pt_BR")
  bodyTemplate    String
  variablesJson   String   @default("[]")
  metaTemplateName String? @unique
  status          String   @default("draft")
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, category, updatedAt])
}

model LilyWhatsAppWebhookEvent {
  id                String   @id @default(cuid())
  dedupeKey         String   @unique
  eventType         String
  providerMessageId String?
  providerStatus    String?
  payloadHash       String
  receivedAt        DateTime @default(now())

  @@index([eventType, receivedAt])
  @@index([providerMessageId, receivedAt])
}

model LilyWhatsAppNotification {
  id                String    @id @default(cuid())
  orderId           String
  stage             String
  status            String    @default("pending")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  provider          String?
  providerMessageId String?
  lastErrorCode     String?
  lastErrorMessage  String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             LilyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, stage])
  @@index([status, nextAttemptAt])
  @@index([orderId, createdAt])
}

model LilyDeliveryRouteEstimate {
  orderId             String    @id
  provider            String
  sourceHash          String
  originLat           Float
  originLng           Float
  destinationLat      Float
  destinationLng      Float
  distanceMeters      Int
  durationSeconds     Int
  calculatedAt        DateTime  @default(now())
  order               LilyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, calculatedAt])
}

model LilyDeliveryAssignment {
  id            String    @id @default(cuid())
  orderId       String
  courierUserId String
  status        String    @default("active")
  assignedBy    String
  assignedAt    DateTime  @default(now())
  endedAt       DateTime?
  endReason     String?
  endNote       String?
  order         LilyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, assignedAt])
  @@index([courierUserId, assignedAt])
  @@index([status, assignedAt])
}

model LilySession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  csrfTokenHash String
  expiresAt     DateTime
  revokedAt     DateTime?
  mfaVerifiedAt DateTime?
  agentKeyId    String?
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  user          LilyUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentKey      LilyAgentKey? @relation(fields: [agentKeyId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@index([agentKeyId])
}

model LilyConsentRecord {
  id         String    @id @default(cuid())
  userId     String
  purpose    String
  version    String
  granted    Boolean
  source     String
  recordedAt DateTime  @default(now())
  revokedAt  DateTime?
  user       LilyUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, recordedAt])
}

model LilyMarketingLead {
  id                 String   @id @default(cuid())
  phoneNormalized    String   @unique
  status             String   @default("subscribed")
  marketingConsentAt DateTime
  consentVersion     String
  privacyVersion     String
  laQr               String?
  laCampaign         String?
  laVariant          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, createdAt])
}

model LilyCategory {
  id           String         @id @default(cuid())
  parentId     String?
  slug         String         @unique
  name         String
  description  String?
  status       String         @default("draft")
  sortOrder    Int            @default(0)
  isComingSoon Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  parent       LilyCategory?  @relation("LilyCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     LilyCategory[] @relation("LilyCategoryTree")
  products     LilyProduct[]
  couponScopes LilyCouponCategory[]

  @@index([parentId])
  @@index([status, sortOrder])
}

model LilyMediaAsset {
  id           String             @id @default(cuid())
  storageName  String             @unique
  originalName String
  mime         String
  size         Int
  sha256       String
  width        Int?
  height       Int?
  altText      String
  placeholder  Boolean            @default(false)
  status       String             @default("active")
  createdAt    DateTime           @default(now())
  coverFor     LilyProduct[]      @relation("LilyProductCover")
  productLinks LilyProductMedia[]
  couponArts   LilyCoupon[]

  @@index([status, createdAt])
}

model LilyProduct {
  id                     String             @id @default(cuid())
  categoryId             String
  coverMediaId           String?
  slug                   String             @unique
  displayName            String
  descriptiveName        String?
  description            String?
  tagsJson               String             @default("[]")
  allergenReviewStatus   String             @default("unreviewed")
  allergenContainsJson   String             @default("[]")
  allergenMayContainJson String             @default("[]")
  configurationType      String             @default("fixed")
  status                 String             @default("draft")
  isAvailable            Boolean            @default(false)
  featured               Boolean            @default(false)
  weeklyHighlight        Boolean            @default(false)
  allowPlaceholder       Boolean            @default(true)
  sortOrder              Int                @default(0)
  preparationLeadMinutes Int?
  minimumAddonUnits     Int                @default(0)
  maximumAddonUnits     Int                @default(4)
  vipEarlyAccess        Boolean            @default(false)
  vipTeaserDescription  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  category               LilyCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverMedia             LilyMediaAsset?    @relation("LilyProductCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  variants               LilyProductVariant[]
  flavorLinks            LilyProductFlavor[]
  addonLinks             LilyProductAddon[]
  mediaLinks             LilyProductMedia[]
  reelLikes              LilyReelLike[]
  reelSaves              LilyReelSave[]
  reelComments           LilyReelComment[]
  mixTiers               LilyMixPriceTier[]
  comboItems             LilyComboItem[]
  offers                 LilyOffer[]
  couponScopes           LilyCouponProduct[]

  @@index([categoryId, status, sortOrder])
  @@index([status, isAvailable, featured])
}

model LilyProductVariant {
  id                     String        @id @default(cuid())
  productId              String
  sizeMl                 Int
  name                   String
  priceCents             Int
  compareAtPriceCents    Int?
  costCents              Int?
  projectedMarginBps     Int?
  status                 String        @default("draft")
  isAvailable            Boolean       @default(false)
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  product                LilyProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers                 LilyOffer[]

  @@unique([productId, sizeMl])
  @@index([productId, status, sortOrder])
}

model LilyFlavorComponent {
  id                String                    @id @default(cuid())
  slug              String                    @unique
  name              String
  status            String                    @default("published")
  premium           Boolean                   @default(false)
  tagsJson          String                    @default("[]")
  allergenReviewStatus   String                @default("unreviewed")
  allergenContainsJson   String                @default("[]")
  allergenMayContainJson String                @default("[]")
  portion300        Int
  portion500        Int
  priceModifier300  Int                       @default(0)
  priceModifier500  Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  productLinks      LilyProductFlavor[]
  addons            LilyAddon[]
  compatibilitiesA  LilyFlavorCompatibility[] @relation("LilyFlavorA")
  compatibilitiesB  LilyFlavorCompatibility[] @relation("LilyFlavorB")

  @@index([status, name])
}

model LilyFlavorCompatibility {
  flavorAId    String
  flavorBId    String
  isCompatible Boolean             @default(true)
  updatedAt    DateTime            @updatedAt
  flavorA      LilyFlavorComponent @relation("LilyFlavorA", fields: [flavorAId], references: [id], onDelete: Cascade)
  flavorB      LilyFlavorComponent @relation("LilyFlavorB", fields: [flavorBId], references: [id], onDelete: Cascade)

  @@id([flavorAId, flavorBId])
  @@index([flavorBId])
}

model LilyProductFlavor {
  productId String
  flavorId  String
  product   LilyProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavor    LilyFlavorComponent @relation(fields: [flavorId], references: [id], onDelete: Cascade)

  @@id([productId, flavorId])
  @@index([flavorId])
}

model LilyAddon {
  id              String               @id @default(cuid())
  flavorId        String?
  slug            String               @unique
  name            String
  priceCents      Int
  portion300      Int
  portion500      Int
  individualLimit Int                  @default(2)
  allergenReviewStatus   String         @default("unreviewed")
  allergenContainsJson   String         @default("[]")
  allergenMayContainJson String         @default("[]")
  status          String               @default("published")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  flavor          LilyFlavorComponent? @relation(fields: [flavorId], references: [id], onDelete: SetNull)
  productLinks    LilyProductAddon[]

  @@index([status, name])
}

model LilyProductAddon {
  productId       String
  addonId         String
  allowed         Boolean     @default(true)
  individualLimit Int?
  priceOverride   Int?
  portion300      Int?
  portion500      Int?
  product         LilyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  addon           LilyAddon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([productId, addonId])
  @@index([addonId])
}

model LilyProductMedia {
  productId String
  mediaId   String
  sortOrder Int            @default(0)
  product   LilyProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     LilyMediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([mediaId, sortOrder])
}

model LilyReelLike {
  userId    String
  productId String
  createdAt DateTime   @default(now())
  user      LilyUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   LilyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId, createdAt])
}

model LilyReelSave {
  userId    String
  productId String
  createdAt DateTime   @default(now())
  user      LilyUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   LilyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
}

model LilyReelComment {
  id        String   @id @default(cuid())
  userId    String
  productId String
  body      String
  status    String   @default("published")
  createdAt DateTime @default(now())
  user      LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   LilyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
}

model LilyMixPriceTier {
  id          String      @id @default(cuid())
  productId   String
  flavorCount Int
  sizeMl      Int
  priceCents  Int
  compareAtPriceCents Int?
  status      String      @default("published")
  product     LilyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, flavorCount, sizeMl])
  @@index([productId, status])
}

model LilyCombo {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  description       String?
  rulesJson         String          @default("{}")
  regularPriceCents Int
  offerPriceCents   Int
  savingsCents      Int
  status            String          @default("draft")
  featured          Boolean         @default(false)
  startsAt          DateTime?
  endsAt            DateTime?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             LilyComboItem[]

  @@index([status, featured, sortOrder])
}

model LilyComboItem {
  id          String      @id @default(cuid())
  comboId     String
  productId   String
  quantity    Int         @default(1)
  sizeMl      Int?
  flavorCount Int?
  combo       LilyCombo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product     LilyProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([comboId])
  @@index([productId])
}

model LilyOffer {
  id                    String              @id @default(cuid())
  productId             String?
  variantId             String?
  name                  String
  regularPriceCents     Int
  offerPriceCents       Int
  savingsCents          Int
  startsAt              DateTime?
  endsAt                DateTime?
  status                String              @default("draft")
  campaignId            String?
  minProjectedMarginBps Int                 @default(1000)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  product               LilyProduct?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant               LilyProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([status, startsAt, endsAt])
  @@index([productId])
  @@index([variantId])
}


model LilyAdminAudit {
  id          String   @id @default(cuid())
  actorUserId String
  actorType   String   @default("human")
  agentKeyId  String?
  agentKeyFingerprint String?
  action      String
  entityType  String
  entityId    String?
  payloadJson String?
  createdAt   DateTime @default(now())
  agentKey    LilyAgentKey? @relation(fields: [agentKeyId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([agentKeyId, createdAt])
}

model LilyAgentKey {
  id             String   @id @default(cuid())
  userId         String   @unique
  label          String
  publicKey      String
  fingerprint    String   @unique
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  user           LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       LilySession[]
  challenges     LilyAgentAuthChallenge[]
  handoffs       LilyAgentAuthHandoff[]
  auditEntries   LilyAdminAudit[]

  @@index([status, updatedAt])
}

model LilyAgentAuthChallenge {
  id          String   @id @default(cuid())
  agentKeyId  String
  challenge   String
  attempts    Int      @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  agentKey    LilyAgentKey @relation(fields: [agentKeyId], references: [id], onDelete: Cascade)

  @@index([agentKeyId, expiresAt, consumedAt])
}

model LilyAgentAuthHandoff {
  id          String   @id @default(cuid())
  agentKeyId  String
  ticketHash  String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  agentKey    LilyAgentKey @relation(fields: [agentKeyId], references: [id], onDelete: Cascade)

  @@index([agentKeyId, expiresAt, consumedAt])
}


model LilyAddress {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  postalCode   String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  reference    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault, createdAt])
}

model LilyOperationalSettings {
  id                   String   @id @default("default")
  ordersEnabled        Boolean  @default(false)
  pickupEnabled        Boolean  @default(false)
  deliveryEnabled      Boolean  @default(false)
  minimumOrderCents    Int      @default(0)
  deliveryStrategy     String   @default("flat")
  flatDeliveryFeeCents Int      @default(0)
  pickupAddressText    String?
  pickupInstructions   String?
  businessHoursJson    String   @default("[]")
  timezone                  String   @default("America/Campo_Grande")
  instagramHandle           String   @default("cook._lily")
  whatsappPhone             String   @default("+5567999289187")
  socialLinksJson           String   @default("[]")
  publicAddressText         String?
  loyaltyOrderCentsPerPoint Int      @default(100)
  loyaltyCampaignBonusPoints Int     @default(10)
  loyaltyCouponBonusPoints Int       @default(10)
  vipPointsThreshold        Int       @default(0)
  referralRewardPoints      Int       @default(0)
  vipAnalyticsRetentionDays Int       @default(180)
  loyaltyRoundingMode String @default("floor")
  paymentsEnabled           Boolean  @default(false)
  paymentProvider           String   @default("manual")
  manualPixEnabled          Boolean  @default(false)
  manualPixInstructions     String?
  mercadoPagoPixEnabled     Boolean  @default(false)
  mercadoPagoCardEnabled    Boolean  @default(false)
  kitchenPreparationSlaMinutes Int?
  createdAt                 DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model LilyDeliveryZone {
  id                     String   @id @default(cuid())
  name                   String
  status                 String   @default("active")
  feeCents               Int
  minimumOrderCents      Int      @default(0)
  neighborhoodsJson      String   @default("[]")
  postalCodePrefixesJson String   @default("[]")
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status, sortOrder, name])
}

model LilyOrder {
  id                  String                 @id @default(cuid())
  orderNumber         String                 @unique
  idempotencyKey      String                 @unique
  requestFingerprint  String
  guestAccessTokenHash String?
  userId              String?
  phoneNormalized     String
  fulfillmentType     String
  status              String                 @default("awaiting_payment")
  operationStatus     String                 @default("received")
  operationUpdatedAt  DateTime               @default(now())
  deliveryStatus      String                 @default("not_applicable")
  deliveryUpdatedAt   DateTime?
  courierUserId       String?
  isHomologation      Boolean                @default(false)
  subtotalCents       Int
  deliveryFeeCents    Int
  discountTotalCents  Int                    @default(0)
  couponDiscountCents Int                    @default(0)
  couponProductDiscountCents Int             @default(0)
  couponShippingDiscountCents Int            @default(0)
  couponsSnapshotJson String                 @default("[]")
  grandTotalCents     Int
  addressSnapshotJson String?
  customerNote        String?
  whatsappUpdatesOptIn Boolean               @default(false)
  whatsappConsentAt    DateTime?
  whatsappConsentVersion String?
  laQr                String?
  laCampaign          String?
  laVariant           String?
  paidAt              DateTime?
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                LilyUser?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               LilyOrderItem[]
  statusEvents        LilyOrderStatusEvent[]
  operationEvents     LilyOrderOperationEvent[]
  deliveryEvents      LilyOrderDeliveryEvent[]
  deliveryAssignments LilyDeliveryAssignment[]
  routeEstimate       LilyDeliveryRouteEstimate?
  whatsappNotifications LilyWhatsAppNotification[]
  payments            LilyPayment[]
  couponRedemptions   LilyCouponRedemption[]

  @@index([userId, createdAt])
  @@index([phoneNormalized, createdAt])
  @@index([status, createdAt])
  @@index([operationStatus, operationUpdatedAt])
  @@index([deliveryStatus, deliveryUpdatedAt])
  @@index([courierUserId, deliveryUpdatedAt])
}

model LilyCoupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  title              String
  description        String?
  type               String
  value              Int      @default(0)
  minimumOrderCents  Int      @default(0)
  maxDiscountCents   Int?
  color              String   @default("#78002E")
  imageMediaId       String?
  status             String   @default("draft")
  startsAt           DateTime?
  endsAt             DateTime?
  recurrence         String   @default("none")
  maxUsesTotal       Int?
  maxUsesPerCustomer Int      @default(1)
  allowCombination   Boolean  @default(false)
  isAdditive         Boolean  @default(false)
  vipOnly            Boolean  @default(false)
  appliesToShipping  Boolean  @default(false)
  usesCount          Int      @default(0)
  createdBy          String?
  assignedUserId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  image              LilyMediaAsset? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  categories         LilyCouponCategory[]
  products           LilyCouponProduct[]
  redemptions        LilyCouponRedemption[]
  assignedUser       LilyUser? @relation("LilyAssignedCoupon", fields: [assignedUserId], references: [id], onDelete: Cascade)

  @@index([status, startsAt, endsAt])
  @@index([updatedAt])
  @@index([assignedUserId, status])
}

model LilyCouponCategory {
  couponId   String
  categoryId String
  coupon     LilyCoupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   LilyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model LilyCouponProduct {
  couponId  String
  productId String
  coupon    LilyCoupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   LilyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model LilyCouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  orderId       String
  discountCents Int
  periodKey     String
  codeSnapshot  String
  titleSnapshot String
  createdAt     DateTime @default(now())
  coupon        LilyCoupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order         LilyOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, periodKey, createdAt])
  @@index([orderId])
}

model LilyOrderItem {
  id                        String               @id @default(cuid())
  orderId                   String
  productId                 String
  variantId                 String
  productNameSnapshot       String
  variantNameSnapshot       String
  sizeMl                    Int
  configurationHash         String
  configurationSnapshotJson String
  flavorsSnapshotJson       String               @default("[]")
  allergenSnapshotJson       String               @default("{\"complete\":false,\"contains\":[],\"mayContain\":[],\"unreviewed\":[]}")
  unitPriceSnapshotCents    Int
  quantity                  Int
  lineTotalCents            Int
  customerNote              String?
  order                     LilyOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addons                    LilyOrderItemAddon[]

  @@index([orderId])
  @@index([productId, variantId])
}

model LilyOrderItemAddon {
  id                     String        @id @default(cuid())
  orderItemId            String
  addonId                String
  addonNameSnapshot      String
  unitPriceSnapshotCents Int
  quantity               Int
  orderItem              LilyOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([addonId])
}

model LilyOrderStatusEvent {
  id         String    @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actor      String
  createdAt  DateTime  @default(now())
  order      LilyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}


model LilyPayment {
  id                   String   @id @default(cuid())
  orderId              String
  idempotencyKey       String   @unique
  provider             String
  method               String
  status               String   @default("pending")
  amountCents          Int
  currency             String   @default("BRL")
  providerPaymentId    String?
  providerReference    String?
  providerDataJson      String?
  instructionsSnapshot String?
  expiresAt            DateTime?
  approvedAt           DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  refundedAt           DateTime?
  refundedCents        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  order                LilyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events               LilyPaymentEvent[]
  reconciliations      LilyPaymentReconciliation[]
  pixSettlements       LilyPixSettlement[]

  @@index([orderId, status, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerPaymentId])
}

model LilyPaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  source          String
  eventType       String
  providerEventId String?  @unique
  fromStatus      String?
  toStatus        String?
  payloadHash     String?
  payloadJson     String?
  createdAt       DateTime @default(now())
  payment         LilyPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([source, eventType, createdAt])
}

model LilyPixSettlement {
  id              String       @id @default(cuid())
  source          String
  providerEventId String       @unique
  endToEndId      String
  txid            String?
  amountCents     Int
  occurredAt      DateTime
  payloadHash     String
  matchStatus     String
  paymentId       String?
  matchedAt       DateTime?
  createdAt       DateTime     @default(now())
  payment         LilyPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([source, occurredAt])
  @@index([txid, matchStatus])
  @@index([paymentId, createdAt])
}

model LilyPixReconciliationState {
  source           String   @id
  lastSuccessfulAt DateTime?
  lastAttemptAt    DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LilyPaymentReconciliation {
  id                    String   @id @default(cuid())
  paymentId             String
  expectedGrossCents    Int
  reportedGrossCents    Int
  feeCents              Int      @default(0)
  netCents              Int
  discrepancyCents      Int      @default(0)
  status                String
  providerReference     String?
  note                  String?
  reconciledBy          String
  createdAt             DateTime @default(now())
  payment               LilyPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model LilyLoyaltyEvent {
  id           String   @id @default(cuid())
  userId       String
  type         String
  points       Int
  sourceKey    String?  @unique
  metadataJson String?
  createdAt    DateTime @default(now())
  user         LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model LilyLevel {
  id             String   @id @default(cuid())
  name           String
  sortOrder      Int      @unique
  requiredPoints Int
  lilyCoins      Int      @default(0)
  benefitsJson   String   @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
}

model LilyCoinEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  kind      String
  sourceKey String   @unique
  metadataJson String @default("{}")
  createdAt DateTime @default(now())
  user      LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LilyReward {
  id             String   @id @default(cuid())
  title          String
  description    String?
  type           String
  lilyCoinCost   Int
  couponId       String?
  productId      String?
  active         Boolean  @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  redemptions    LilyRewardRedemption[]

  @@index([active, startsAt, endsAt])
}

model LilyRewardRedemption {
  id            String   @id @default(cuid())
  rewardId      String
  userId        String
  coinEventId   String   @unique
  createdAt     DateTime @default(now())
  reward        LilyReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  user          LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LilyReferralInvite {
  id             String   @id @default(cuid())
  code           String   @unique
  referrerUserId String
  referredUserId String?  @unique
  creditedPoints Int      @default(0)
  createdAt      DateTime @default(now())
  creditedAt     DateTime?
  referrer       LilyUser @relation("LilyReferralOwner", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUser   LilyUser? @relation("LilyReferralRecipient", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([referrerUserId, createdAt])
}

model LilyVipCode {
  id              String   @id @default(cuid())
  codeHash        String   @unique
  displaySuffix   String
  kind            String
  couponIdsJson   String   @default("[]")
  status          String   @default("active")
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptions  Int?
  redemptionCount Int      @default(0)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  redemptions     LilyVipRedemption[]

  @@index([status, startsAt, endsAt])
}

model LilyVipRedemption {
  id          String   @id @default(cuid())
  userId      String
  vipCodeId   String
  createdAt   DateTime @default(now())
  user        LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  vipCode     LilyVipCode @relation(fields: [vipCodeId], references: [id], onDelete: Restrict)

  @@unique([userId, vipCodeId])
  @@index([userId, createdAt])
}

model LilyVipMembership {
  id             String   @id @default(cuid())
  userId         String   @unique
  status         String   @default("invited")
  source         String
  consentVersion String?
  consentedAt    DateTime?
  enrolledAt     DateTime?
  canceledAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, enrolledAt])
}

model LilyVipAnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  event     String
  reference String?
  metadataJson String @default("{}")
  occurredAt DateTime @default(now())
  user      LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([event, occurredAt])
}

model LilySurvey {
  id                    String   @id @default(cuid())
  publicToken           String?  @unique
  title                 String
  subtitle              String?
  description           String?
  status                String   @default("draft")
  version               Int      @default(1)
  formJson              String   @default("[]")
  prerequisitesJson     String   @default("[]")
  unlocksMissionsJson   String   @default("[]")
  pointsPerForm         Int      @default(0)
  pointsPerAnswer       Int      @default(0)
  showPoints            Boolean  @default(false)
  allowNavigation       Boolean  @default(true)
  mediaMimeTypesJson    String   @default("[]")
  mediaMaxBytes         Int      @default(0)
  estimatedMinutes     Int      @default(5)
  createdByUserId       String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  publishedAt           DateTime?
  participations        LilySurveyParticipation[]
  responses             LilySurveyResponse[]
  views                 LilySurveyView[]
  questionMetrics       LilySurveyQuestionMetric[]

  @@index([status, publishedAt])
}

model LilyCustomerNotification {
  id           String   @id @default(cuid())
  userId       String
  sourceKey    String
  type         String
  title        String
  body         String
  metadataJson String   @default("{}")
  readAt       DateTime?
  createdAt    DateTime @default(now())
  user         LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, readAt, createdAt])
}

model LilySurveyView {
  id        String   @id @default(cuid())
  surveyId  String
  viewId    String
  viewedAt  DateTime @default(now())
  survey    LilySurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, viewId])
  @@index([surveyId, viewedAt])
}

model LilySurveyQuestionMetric {
  id            String   @id @default(cuid())
  surveyId      String
  surveyVersion Int
  questionId    String
  optionKey     String
  optionLabel   String
  selectedCount Int      @default(0)
  timeTotalMs   Float    @default(0)
  timeSamples   Int      @default(0)
  survey        LilySurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, surveyVersion, questionId, optionKey])
  @@index([surveyId, surveyVersion, questionId])
}

model LilySurveyParticipation {
  id              String   @id @default(cuid())
  userId          String
  surveyId        String
  surveyVersion   Int
  status          String   @default("in_progress")
  progressPercent Int      @default(0)
  questionTimesJson String @default("{}")
  pointsAwarded   Int      @default(0)
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  user            LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  survey          LilySurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  uploads         LilySurveyUpload[]

  @@unique([userId, surveyId, surveyVersion])
  @@index([userId, status, completedAt])
  @@index([surveyId, status, startedAt])
}

model LilySurveyResponse {
  id                    String   @id @default(cuid())
  surveyId              String
  surveyVersion         Int
  respondentUserId      String?
  respondentConsented   Boolean  @default(false)
  answersJson           String   @default("{}")
  submittedAt           DateTime @default(now())
  survey                LilySurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent            LilyUser? @relation(fields: [respondentUserId], references: [id], onDelete: SetNull)

  @@index([surveyId, submittedAt])
  @@index([respondentUserId, submittedAt])
}

model LilyMission {
  id               String   @id @default(cuid())
  title            String
  description      String?
  status           String   @default("draft")
  points           Int      @default(0)
  lilyCoins         Int      @default(0)
  prerequisiteJson String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

model LilySurveyUpload {
  id              String   @id @default(cuid())
  participationId String
  userId          String
  questionId      String
  storageName     String   @unique
  originalName    String
  mime            String
  size            Int
  createdAt       DateTime @default(now())
  participation   LilySurveyParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  user            LilyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([participationId, questionId])
  @@index([userId, createdAt])
}


model LilyAnalyticsEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique
  sessionId     String
  event         String
  path          String
  laQr          String?
  laCampaign    String?
  laVariant     String?
  surface       String?
  productSlug   String?
  comboSlug     String?
  variantSizeMl Int?
  addonCount    Int?
  itemCount     Int?
  fulfillmentType String?
  paymentMethod String?
  metadataJson  String   @default("{}")
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  @@index([event, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([laCampaign, laVariant, occurredAt])
  @@index([laQr, occurredAt])
  @@index([productSlug, event, occurredAt])
}
