generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String   @id
  name        String
  tagline     String
  version     Int      @default(1)
  stage       String
  timezone    String
  site        String
  instagram   String
  whatsapp    String
  northStar   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pillars     Pillar[]
  milestones  Milestone[]
  agents      AgentDefinition[]
  tasks       Task[]
  decisions   Decision[]
  risks       Risk[]
  procurement ProcurementItem[]
  notes       Note[]
  intents     OperationalIntent[]
  facts       BusinessFact[]
  knowledgeNodes KnowledgeNode[]
}

model Pillar {
  id          String   @id
  projectId   String
  name        String
  description String?
  color       String?
  order       Int      @default(0)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Milestone {
  id           String   @id
  projectId    String
  name         String
  objective    String
  status       String
  exitCriteria String
  order        Int      @default(0)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
}

model AgentDefinition {
  id          String   @id
  projectId   String
  name        String
  role        String
  mission     String
  model       String?
  reasoningEffort String @default("medium")
  browserEnabled Boolean @default(false)
  workspaceMode String   @default("read_only")
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  runs        AgentRun[]
  dispatches AgentDispatch[]
}

model Task {
  id                  String   @id
  projectId           String
  pillarId            String
  milestoneId         String
  ownerAgentId        String
  title               String
  impact              Int
  urgency             Int
  status              String
  statusJustification String?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  acceptance          String
  evidenceJson        String   @default("[]")
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pillar              Pillar   @relation(fields: [pillarId], references: [id])
  milestone           Milestone @relation(fields: [milestoneId], references: [id])
  owner               AgentDefinition @relation(fields: [ownerAgentId], references: [id])
  dependsOn           TaskDependency[] @relation("TaskDependsOn")
  dependents          TaskDependency[] @relation("TaskDependent")
  transitions         TaskStatusTransition[]
  runs                AgentRun[]
  questions           AgentQuestion[]
  changeRequests      ChangeRequest[]
  auditEvents         AuditEvent[]
  uploads             Upload[]
  notifications       Notification[]
  browserNavigations  BrowserNavigation[]

  @@index([status])
  @@index([ownerAgentId])
  @@index([milestoneId])
}

model TaskDependency {
  taskId       String
  dependencyId String
  task         Task   @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependency   Task   @relation("TaskDependent", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@id([taskId, dependencyId])
}

model TaskStatusTransition {
  id            String   @id @default(cuid())
  taskId        String
  fromStatus    String
  toStatus      String
  justification String
  actor         String
  evidenceJson  String   @default("[]")
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Decision {
  id             String   @id
  projectId      String
  question       String
  ownerAgentId   String
  due            String?
  status         String
  recommendation String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contexts       DecisionContext[]
  uploads        Upload[]
  auditEvents    AuditEvent[]
}

model DecisionContext {
  id         String   @id @default(cuid())
  decisionId String
  actor      String
  content    String
  sourceUrl  String?
  createdAt  DateTime @default(now())
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
}

model Risk {
  id          String   @id
  projectId   String
  title       String
  ownerAgentId String
  probability Int
  impact       Int
  status       String
  mitigation   String
  trigger      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProcurementItem {
  id              String   @id
  projectId       String
  item            String
  category        String
  ownerAgentId    String
  status          String
  neededBy        String?
  requirementsJson String  @default("[]")
  budgetCeilingJson String?
  recommendation String?
  optionsJson     String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id
  projectId String
  title     String
  content   String
  ownerAgentId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChangeRequest {
  id          String   @id
  taskId      String?
  actor       String
  action      String
  reason      String
  payloadJson String
  status      String   @default("pending")
  reviewer    String?
  reviewNote  String?
  resultJson  String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  taskId      String?
  decisionId  String?
  actor       String
  action      String
  entityType  String
  entityId    String
  summary     String
  beforeJson  String?
  afterJson   String?
  correlationId String?
  createdAt   DateTime @default(now())
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decision    Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([decisionId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
}

model UiState {
  id             String   @id @default(cuid())
  userId         String
  scope          String
  route          String
  search         String   @default("")
  hash           String   @default("")
  scrollY        Int      @default(0)
  sidebarOpen    Boolean  @default(true)
  selectedTaskId String?
  filtersJson    String   @default("{}")
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@unique([userId, scope])
}

model AgentRun {
  id               String   @id @default(cuid())
  taskId           String?
  agentId          String
  intentId         String?
  managementConversationId String?
  parentRunId      String?
  provider         String   @default("manual")
  externalThreadId String?
  title            String
  objective        String
  status           String   @default("queued")
  currentStep      String?
  requestedBy      String
  purpose          String   @default("execution")
  complexity       String   @default("medium")
  selectedModel    String?
  selectedReasoningEffort String @default("medium")
  routingReason    String?
  startedAt        DateTime?
  lastHeartbeatAt  DateTime?
  finishedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  task             Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agent            AgentDefinition @relation(fields: [agentId], references: [id])
  intent           OperationalIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  managementConversation ManagementConversation? @relation(fields: [managementConversationId], references: [id], onDelete: SetNull)
  parentRun        AgentRun? @relation("RunDispatchTree", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns        AgentRun[] @relation("RunDispatchTree")
  steps            AgentStep[]
  messages         AgentMessage[]
  questions        AgentQuestion[]
  usage            UsageRecord[]
  logs             AgentLog[]
  report           AgentRunReport?
  communications   AgentCommunication[]
  uploads          Upload[]
  notification     Notification?
  browserNavigations BrowserNavigation[]
  managementMessages ManagementMessage[]
  dispatchesSent     AgentDispatch[] @relation("DispatchSource")
  dispatchResults    AgentDispatch[] @relation("DispatchResult")
  knowledgeNodes     KnowledgeNode[]

  @@index([status, createdAt])
  @@index([intentId, createdAt])
  @@index([managementConversationId, createdAt])
  @@index([parentRunId, createdAt])
  @@index([purpose, status, createdAt])
}

model ManagementConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ManagementMessage[]
  runs      AgentRun[]

  @@index([userId, status, updatedAt])
}

model ManagementMessage {
  id             String   @id @default(cuid())
  conversationId String
  runId          String?
  sender         String
  content        String
  referencesJson String   @default("[]")
  createdAt      DateTime @default(now())
  conversation   ManagementConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  uploads        Upload[]

  @@index([conversationId, createdAt])
  @@index([runId, createdAt])
}

model AgentDispatch {
  id                   String   @id @default(cuid())
  sourceRunId          String
  targetAgentId        String
  resultRunId          String?
  message              String
  dataRef              String?
  contextJson          String   @default("{}")
  isRequiredToProceed  Boolean  @default(false)
  dependenciesJson     String   @default("[]")
  onSuccessJson        String   @default("{}")
  status               String   @default("buffered")
  createdAt            DateTime @default(now())
  dispatchedAt         DateTime?
  completedAt          DateTime?
  sourceRun            AgentRun @relation("DispatchSource", fields: [sourceRunId], references: [id], onDelete: Cascade)
  targetAgent          AgentDefinition @relation(fields: [targetAgentId], references: [id])
  resultRun            AgentRun? @relation("DispatchResult", fields: [resultRunId], references: [id], onDelete: SetNull)

  @@index([sourceRunId, status, createdAt])
  @@index([resultRunId])
  @@index([targetAgentId, status, createdAt])
}

model OperationalIntent {
  id                 String   @id @default(cuid())
  projectId          String
  prompt             String
  submittedBy        String
  subject            String
  summary            String
  status             String   @default("queued")
  classificationJson String
  createdAt          DateTime @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs               AgentRun[]
  facts              BusinessFact[]
  knowledgeNodes     KnowledgeNode[]
  notification       Notification?
  communications     AgentCommunication[]
  uploads            Upload[]

  @@index([status, createdAt])
}

model BusinessFact {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  value          String
  verificationStatus String @default("pending_verification")
  sourceIntentId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceIntent   OperationalIntent? @relation(fields: [sourceIntentId], references: [id], onDelete: SetNull)

  @@unique([projectId, key])
  @@index([sourceIntentId])
}

model KnowledgeNode {
  id                 String   @id @default(cuid())
  projectId          String
  parentId           String?
  sourceRunId        String?
  sourceIntentId     String?
  slug               String
  name               String
  path               String
  kind               String   @default("branch")
  value              String?
  valueType          String   @default("text")
  verificationStatus String   @default("informed")
  referencesJson     String   @default("[]")
  sourceType         String   @default("manual")
  sourceId           String?
  createdBy          String
  status             String   @default("active")
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent             KnowledgeNode? @relation("KnowledgeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           KnowledgeNode[] @relation("KnowledgeTree")
  sourceRun          AgentRun? @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  sourceIntent       OperationalIntent? @relation(fields: [sourceIntentId], references: [id], onDelete: SetNull)
  attachments        KnowledgeNodeAttachment[]

  @@unique([projectId, path])
  @@index([parentId, status, name])
  @@index([sourceRunId])
  @@index([sourceIntentId])
  @@index([status, updatedAt])
}

model KnowledgeNodeAttachment {
  nodeId    String
  uploadId  String
  createdAt DateTime @default(now())
  node      KnowledgeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  upload    Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([nodeId, uploadId])
  @@index([uploadId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  intentId  String?  @unique
  runId     String?  @unique
  taskId    String?
  type      String
  title     String
  message   String
  route     String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  intent    OperationalIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  run       AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  task      Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

model AgentStep {
  id          String   @id @default(cuid())
  runId       String
  order       Int
  title       String
  description String?
  status      String   @default("pending")
  procedure   String?
  result      String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, order])
}

model AgentMessage {
  id          String   @id @default(cuid())
  runId       String
  sender      String
  kind        String
  content     String
  createdAt   DateTime @default(now())
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model AgentQuestion {
  id            String   @id @default(cuid())
  runId         String
  taskId        String
  askedBy       String
  question      String
  context       String
  recommendation String?
  optionsJson   String   @default("[]")
  blocking      Boolean  @default(true)
  status        String   @default("pending")
  answer        String?
  answerReferencesJson String @default("[]")
  answeredBy    String?
  answeredAt    DateTime?
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())
  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploads       Upload[]

  @@index([status, createdAt])
}

model UsageRecord {
  id              String   @id @default(cuid())
  runId           String
  source          String
  model           String?
  inputTokens     Int?
  cachedInputTokens Int?
  outputTokens    Int?
  reasoningTokens Int?
  totalTokens     Int?
  durationMs      Int?
  costMicros      Int?
  createdAt       DateTime @default(now())
  run             AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model AgentLog {
  id        String   @id @default(cuid())
  runId     String
  sequence  Int
  channel   String
  eventType String
  title     String?
  content   String
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
}

model AgentRunReport {
  id                  String   @id @default(cuid())
  runId               String   @unique
  outcome             String
  summary             String
  diagnosis           String?
  successesJson       String   @default("[]")
  failuresJson        String   @default("[]")
  recommendationsJson String   @default("[]")
  evidenceJson        String   @default("[]")
  generatedBy         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  run                 AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model AgentCommunication {
  id           String   @id @default(cuid())
  runId        String?
  intentId     String?
  sourceId     String
  targetId     String
  kind         String
  status       String   @default("delivered")
  summary      String
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  run          AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  intent       OperationalIntent? @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sourceId, targetId, createdAt])
  @@index([runId, createdAt])
  @@index([intentId, createdAt])
}

model Upload {
  id           String   @id @default(cuid())
  taskId       String?
  runId        String?
  intentId     String?
  decisionId   String?
  questionId   String?
  managementMessageId String?
  actor        String
  originalName String
  storageName  String   @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime @default(now())
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  run          AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  intent       OperationalIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  decision     Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  question     AgentQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  managementMessage ManagementMessage? @relation(fields: [managementMessageId], references: [id], onDelete: SetNull)
  knowledgeNodes KnowledgeNodeAttachment[]

  @@index([taskId, createdAt])
  @@index([runId, createdAt])
  @@index([intentId, createdAt])
  @@index([decisionId, createdAt])
  @@index([questionId, createdAt])
  @@index([managementMessageId, createdAt])
}

model BrowserNavigation {
  id         String   @id @default(cuid())
  runId      String
  taskId     String
  actor      String
  targetType String
  target     String
  title      String?
  reason     String?
  status     String   @default("requested")
  resultJson String   @default("{}")
  createdAt  DateTime @default(now())
  openedAt   DateTime?
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([taskId, createdAt])
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  name        String
  url         String
  eventsJson  String
  secretRef   String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  eventId     String
  status      String   @default("pending")
  attempt     Int      @default(0)
  responseCode Int?
  error       String?
  createdAt   DateTime @default(now())
  deliveredAt DateTime?
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
}

model WebhookInbox {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payloadJson String
  signatureValid Boolean
  status      String   @default("received")
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
}

model OutboxEvent {
  id          String   @id @default(cuid())
  topic       String
  aggregateType String
  aggregateId String
  payloadJson String
  status      String   @default("pending")
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())

  @@index([status, availableAt])
}

model ImportBatch {
  id          String   @id @default(cuid())
  source      String
  sourceHash  String
  countsJson  String
  importedAt  DateTime @default(now())
}
